---
import Signature from '@/components/brand/Signature.astro';
import ContactRow from '@/components/brand/ContactRow.astro';
import Icon from '@/components/ui/Icon.astro';
import { t } from '@/i18n/ui';
import { href, alternatePath, type Locale, type PageKey } from '@/i18n/routes';

interface Props { lang: Locale; current?: PageKey | undefined }
const { lang, current } = Astro.props;
const u = t(lang);
const other: Locale = lang === 'ar' ? 'en' : 'ar';
const altHref = alternatePath(Astro.url.pathname, other);
const links: { key: PageKey; label: string }[] = [
  { key: 'about', label: u.nav.about },
  { key: 'advisory', label: u.nav.advisory },
  { key: 'insights', label: u.nav.insights },
  { key: 'contact', label: u.nav.contact },
];
---
<header class="site-header" data-tone="day" data-header>
  <div class="wrap site-header__bar">
    <a class="site-header__home" href={href(lang, 'home')} aria-label={u.nav.home}>
      <Signature variant="compact" surface="light" lang={lang} width="128px" loading="eager" />
    </a>

    <nav class="site-header__nav" aria-label={u.nav.label}>
      <ul>
        {links.map((l) => (
          <li><a href={href(lang, l.key)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="lang-switch" href={altHref} hreflang={other} lang={other} aria-label={u.lang.switchLabel}>
        <span>{u.lang.switchTo}</span>
      </a>
      <a class="btn site-header__cta" href={href(lang, 'interest')}>{u.cta.ask}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <Icon name="menu" /><span class="visually-hidden">{u.nav.menu}</span>
      </button>
    </div>
  </div>

  <div class="site-menu ambient-day" id="site-menu" data-menu hidden>
    <div class="wrap site-menu__inner">
      <div class="site-menu__top">
        <Signature variant="compact" surface="light" lang={lang} width="128px" />
        <button class="menu-toggle" type="button" data-menu-close>
          <Icon name="close" /><span class="visually-hidden">{u.nav.close}</span>
        </button>
      </div>
      <nav aria-label={u.nav.label}>
        <ul class="site-menu__links">
          <li><a href={href(lang, 'home')} aria-current={current === 'home' ? 'page' : undefined}>{u.nav.home}</a></li>
          {links.map((l) => (
            <li><a href={href(lang, l.key)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li><a href={href(lang, 'interest')} aria-current={current === 'interest' ? 'page' : undefined}>{u.nav.interest}</a></li>
        </ul>
      </nav>
      <div class="site-menu__foot">
        <a class="lang-switch" href={altHref} hreflang={other} lang={other}>{u.lang.switchTo}</a>
        <ContactRow lang={lang} />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; inset-block-start: 0; z-index: 100;
    background: transparent; transition: background-color var(--kha-motion-duration-standard) var(--kha-motion-ease-human),
      box-shadow var(--kha-motion-duration-standard) var(--kha-motion-ease-human);
  }
  .site-header[data-scrolled='true'] {
    background: color-mix(in srgb, var(--kha-color-paper) 94%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--kha-color-ink) 8%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
  }
  .site-header__bar { display: flex; align-items: center; gap: 24px; block-size: var(--web-header-h); }
  .site-header__home { display: block; margin-inline-end: auto; flex: none; border-radius: 6px; }
  .site-header__home :global(.signature) { inline-size: clamp(104px, 9vw, 132px) !important; }
  .site-header__nav ul { list-style: none; padding: 0; display: flex; gap: clamp(16px, 2.2vw, 34px); }
  .site-header__nav a {
    display: inline-block; padding-block: 10px; text-decoration: none; font-size: 0.975rem; font-weight: 500;
    color: var(--kha-color-ink); position: relative;
  }
  .site-header__nav a::after {
    content: ''; position: absolute; inset-inline: 0; inset-block-end: 4px; block-size: 1px;
    background: var(--kha-color-mawj); transform: scaleX(0); transform-origin: var(--origin, right);
    transition: transform var(--kha-motion-duration-fast) var(--kha-motion-ease-precision);
  }
  :global([dir='ltr']) .site-header__nav a::after { --origin: left; }
  .site-header__nav a:hover::after, .site-header__nav a[aria-current='page']::after { transform: none; }
  .site-header__nav a[aria-current='page'] { color: var(--kha-color-bahr); }
  .site-header__tools { display: flex; align-items: center; gap: 14px; }
  .lang-switch {
    font-size: 0.9rem; font-weight: 500; text-decoration: none; padding: 10px 6px; color: var(--kha-color-bahr);
  }
  .lang-switch:hover { text-decoration: underline; }
  .site-header__cta { min-block-size: 44px; padding: 10px 20px; font-size: 0.95rem; }
  .menu-toggle {
    display: none; inline-size: 48px; block-size: 48px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--kha-color-ink) 18%, transparent);
    background: color-mix(in srgb, white 55%, transparent); color: var(--kha-color-ink); place-items: center;
  }
  .menu-toggle :global(.icon) { inline-size: 22px; block-size: 22px; }

  .site-menu { position: fixed; inset: 0; z-index: 120; overflow-y: auto; }
  .site-menu[hidden] { display: none; }
  .site-menu__inner { min-block-size: 100%; display: flex; flex-direction: column; padding-block: 12px 32px; }
  .site-menu__top { display: flex; align-items: center; justify-content: space-between; block-size: var(--web-header-h); }
  .site-menu__links { list-style: none; padding: 0; margin-block: 6vh 4vh; }
  .site-menu__links a {
    display: block; padding-block: 10px; text-decoration: none; color: var(--kha-color-bahr);
    font-size: clamp(1.9rem, 7vw, 2.6rem); line-height: 1.3; font-weight: 600;
  }
  :global(:lang(ar)) .site-menu__links a { font-family: var(--web-font-ar-display); }
  .site-menu__links a[aria-current='page'] { color: var(--kha-color-mawj); }
  .site-menu__foot { margin-block-start: auto; display: grid; gap: 20px; border-block-start: 1px solid var(--kha-ambient-rule-on-zabad); padding-block-start: 20px; }

  @media (max-width: 980px) {
    .site-header__nav, .site-header__cta { display: none; }
    .menu-toggle { display: grid; }
    :global(html:not(.js)) .site-header__nav { display: block; }
  }
  @media (max-width: 380px) { .site-header__tools .lang-switch { display: none; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 24));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  };
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setOpen(false);
    if (e.key === 'Tab' && menu && !menu.hidden) {
      const f = [...menu.querySelectorAll<HTMLElement>('a[href],button')];
      const first = f[0];
      const last = f[f.length - 1];
      if (!first || !last) return;
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
</script>
