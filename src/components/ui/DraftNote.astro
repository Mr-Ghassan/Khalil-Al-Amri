---
/**
 * Visible DRAFT marker. Renders ONLY in preview mode; production builds drop it together with
 * any content flagged draft (see src/lib/content.ts).
 */
import { IS_PREVIEW } from '@/config/site';
import Icon from './Icon.astro';
import type { Locale } from '@/i18n/routes';

interface Props { lang: Locale; title?: string; class?: string }
const { lang, title, class: cls } = Astro.props;
const label = lang === 'ar' ? 'مسودة — ' : 'Draft — ';
---
{IS_PREVIEW && (
  <aside class:list={['draft-note', cls]} role="note">
    <Icon name="info" />
    <div><strong>{label}{title}</strong> <slot /></div>
  </aside>
)}
<style>
  .draft-note :global(.icon) { inline-size: 20px; block-size: 20px; flex: none; color: var(--kha-color-luban); margin-block-start: 2px; }
</style>
