# preview  → noindex, DRAFT content visible with labels, prototype form
# production → draft content excluded, indexable; refuses to build while launch blockers are open (see scripts/launch-gate.mjs)
PUBLIC_SITE_MODE=preview
SITE_URL=https://www.khalilprop.com
# Lead intake: "prototype" is the only mode implemented. Nothing is ever transmitted in prototype mode.
PUBLIC_LEAD_MODE=prototype
# Set to 1 only after licensed web font files are placed in public/fonts/licensed/ (never committed).
PUBLIC_LICENSED_FONTS=0
